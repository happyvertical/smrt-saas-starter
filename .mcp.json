{
  "mcpServers": {
    "smrt-dev-mcp": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@happyvertical/smrt-dev-mcp@0.37.3"]
    },
    "happyvertical-sdk-mcp": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@happyvertical/sdk-mcp@0.74.11"]
    },
    "playwright": {
      "type": "stdio",
      "command": "pnpm",
      "args": ["dlx", "@playwright/mcp"],
      "env": {
        "PLAYWRIGHT_MCP_ISOLATED": "true"
      }
    },
    "mcp-svelte-docs": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "mcp-svelte-docs"],
      "env": {}
    }
  }
}
