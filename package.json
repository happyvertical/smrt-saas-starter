{
  "name": "smrt-saas-starter",
  "version": "0.1.1",
  "private": true,
  "description": "Canonical HappyVertical SMRT multi-tenant SaaS starter, reference app, and ecosystem demo.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.13.0",
  "engines": {
    "node": ">=24.18.0",
    "pnpm": ">=11.13.0"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "format": "biome check --write .",
    "format:check": "biome check .",
    "lint": "biome lint . && pnpm -r --if-present lint",
    "lint:fix": "biome lint --write .",
    "typecheck": "turbo run typecheck",
    "test": "pnpm -r --if-present test && node --test scripts/__tests__/*.test.mjs",
    "test:e2e": "pnpm -r --if-present test:e2e",
    "test:e2e:production": "pnpm build && pnpm runtime:prepare && node scripts/run-production-e2e.mjs",
    "build": "turbo run build",
    "services:up": "docker compose up -d --wait postgres",
    "services:down": "docker compose down",
    "services:logs": "docker compose logs -f postgres",
    "services:ps": "docker compose ps",
    "db:up": "pnpm services:up",
    "db:migrate": "pnpm --filter @happyvertical/smrt-saas-web db:migrate",
    "db:profiles:backfill": "pnpm db:migrate && pnpm --filter @happyvertical/smrt-saas-web db:profiles:backfill",
    "db:seed": "pnpm db:migrate && pnpm --filter @happyvertical/smrt-saas-web db:seed",
    "db:smoke": "pnpm db:seed && pnpm --filter @happyvertical/smrt-saas-web db:smoke",
    "deps:check": "node scripts/check-dependencies.mjs",
    "workflows:check": "node scripts/check-workflows.mjs",
    "manifests:check": "node scripts/check-manifests.mjs",
    "manifests:render": "node scripts/render-manifests.mjs",
    "sops:check": "node scripts/check-sops.mjs",
    "validate": "node scripts/validate-scaffold.mjs",
    "check": "pnpm deps:check && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm db:smoke && pnpm workflows:check && pnpm manifests:check && pnpm sops:check && pnpm validate",
    "runtime:prepare": "node scripts/prepare-runtime.mjs",
    "images:build": "node scripts/build-runtime-images.mjs",
    "images:smoke": "node scripts/smoke-runtime-images.mjs",
    "runtime:check": "pnpm build && pnpm runtime:prepare && pnpm images:build && pnpm images:smoke && pnpm manifests:render",
    "mobile:validate": "pnpm --filter @happyvertical/smrt-saas-mobile validate:shell",
    "mobile:validate:android": "pnpm --filter @happyvertical/smrt-saas-mobile validate:android",
    "mobile:validate:ios": "pnpm --filter @happyvertical/smrt-saas-mobile validate:ios",
    "mobile:validate:native": "pnpm mobile:validate:android && pnpm mobile:validate:ios",
    "mobile:generate": "pnpm --filter @happyvertical/smrt-saas-mobile-contract generate",
    "objects:test": "pnpm --filter @happyvertical/smrt-saas-objects test",
    "prepare": "git rev-parse --git-dir > /dev/null 2>&1 && lefthook install || echo 'Skipping lefthook install (not in git repository)'"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@playwright/test": "^1.58.2",
    "@sveltejs/adapter-node": "^5.5.4",
    "@sveltejs/kit": "2.69.3",
    "@sveltejs/vite-plugin-svelte": "7.2.0",
    "@types/node": "^24.10.1",
    "@vitest/coverage-v8": "4.1.10",
    "lefthook": "2.1.10",
    "playwright": "^1.58.2",
    "svelte": "5.56.5",
    "svelte-check": "^4.0.0",
    "turbo": "2.10.5",
    "typescript": "5.9.3",
    "vite": "8.1.4",
    "vitest": "4.1.10"
  }
}
