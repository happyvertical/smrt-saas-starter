DATABASE_URL=postgresql://smrt_saas:localdev@127.0.0.1:5432/smrt_saas
POSTGRES_IMAGE=postgres:18-alpine
POSTGRES_PORT=5432
POSTGRES_DB=smrt_saas
POSTGRES_USER=smrt_saas
POSTGRES_PASSWORD=localdev
PUBLIC_APP_NAME="SMRT SaaS Starter"
PUBLIC_SITE_URL=http://localhost:5173
# Kanidm serves OIDC discovery per client at /oauth2/openid/<client-id>/, not
# at the IDP root (the root issuer 404s on discovery). Use the per-client
# issuer that matches OIDC_CLIENT_ID.
HAPPYVERTICAL_IDP_ISSUER=https://idp.happyvertical.com/oauth2/openid/<client-id>
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
MOBILE_AUTH_DEFAULT_PROVIDER=happyvertical
MOBILE_AUTH_HAPPYVERTICAL_TYPE=kanidm
MOBILE_OIDC_CLIENT_ID=
MOBILE_OIDC_CLIENT_SECRET=
MOBILE_SESSION_TTL_SECONDS=2592000
# Optional JSON array for additional @happyvertical/auth OAuth/OIDC providers.
# Example: [{"id":"google","label":"Google","type":"google","clientId":"","clientSecret":"","scopes":["openid","profile","email"]}]
MOBILE_AUTH_PROVIDERS_JSON=
SESSION_SECRET=replace-with-local-random-value
SMRT_STARTER_DEV_AUTH=true
SMRT_STARTER_AUTH_INLINE_LINKS=true
SMRT_STARTER_SUPERUSER_EMAILS=
# E2E auth: when E2E_AUTH_SECRET is set, POST /api/e2e/session mints a real
# session for E2E_USER_EMAIL (must be a seeded user) after a constant-time
# secret check. Leave unset everywhere except e2e environments — the route is
# a 404 without it. Never set E2E_AUTH_SECRET in production.
E2E_AUTH_SECRET=
E2E_USER_EMAIL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_SCALE=
SENTRY_DSN=
