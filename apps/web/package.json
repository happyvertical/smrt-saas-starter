{
  "name": "@happyvertical/smrt-saas-web",
  "version": "0.1.0",
  "private": true,
  "description": "SvelteKit web app for the SMRT SaaS starter.",
  "type": "module",
  "files": [
    ".smrt/",
    "build/",
    "scripts/smrt-db-migrate.mjs",
    "scripts/smrt-db-seed.mjs",
    "scripts/smrt-db-smoke.mjs",
    "smrt-packages.mjs",
    "smrt.config.mjs"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "types": "./src/index.ts",
  "scripts": {
    "dev": "vite dev --host 0.0.0.0",
    "build": "vite build && node scripts/generate-runtime-manifest.mjs",
    "db:migrate": "node scripts/smrt-db-migrate.mjs",
    "db:seed": "node scripts/smrt-db-seed.mjs",
    "db:smoke": "node scripts/smrt-db-smoke.mjs",
    "preview": "vite preview",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "biome lint src",
    "test": "vitest run --passWithNoTests --exclude \"e2e/**\"",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@happyvertical/accounting": "catalog:",
    "@happyvertical/ai": "catalog:",
    "@happyvertical/analytics": "catalog:",
    "@happyvertical/auth": "catalog:",
    "@happyvertical/cache": "catalog:",
    "@happyvertical/files": "catalog:",
    "@happyvertical/github-actions": "catalog:",
    "@happyvertical/jobs": "catalog:",
    "@happyvertical/logger": "catalog:",
    "@happyvertical/messages": "catalog:",
    "@happyvertical/projects": "catalog:",
    "@happyvertical/repos": "catalog:",
    "@happyvertical/secrets": "catalog:",
    "@happyvertical/smrt-agents": "catalog:",
    "@happyvertical/smrt-analytics": "catalog:",
    "@happyvertical/smrt-app-mcp": "catalog:",
    "@happyvertical/smrt-assets": "catalog:",
    "@happyvertical/smrt-chat": "catalog:",
    "@happyvertical/smrt-cli": "catalog:",
    "@happyvertical/smrt-commerce": "catalog:",
    "@happyvertical/smrt-config": "catalog:",
    "@happyvertical/smrt-content": "catalog:",
    "@happyvertical/smrt-core": "catalog:",
    "@happyvertical/smrt-features": "catalog:",
    "@happyvertical/smrt-jobs": "catalog:",
    "@happyvertical/smrt-languages": "catalog:",
    "@happyvertical/smrt-ledgers": "catalog:",
    "@happyvertical/smrt-messages": "catalog:",
    "@happyvertical/smrt-profiles": "catalog:",
    "@happyvertical/smrt-projects": "catalog:",
    "@happyvertical/smrt-prompts": "catalog:",
    "@happyvertical/smrt-saas-objects": "workspace:*",
    "@happyvertical/smrt-saas-ui": "workspace:*",
    "@happyvertical/smrt-scanner": "catalog:",
    "@happyvertical/smrt-secrets": "catalog:",
    "@happyvertical/smrt-sites": "catalog:",
    "@happyvertical/smrt-subscriptions": "catalog:",
    "@happyvertical/smrt-svelte": "catalog:",
    "@happyvertical/smrt-tags": "catalog:",
    "@happyvertical/smrt-tenancy": "catalog:",
    "@happyvertical/smrt-types": "catalog:",
    "@happyvertical/smrt-ui": "catalog:",
    "@happyvertical/smrt-users": "catalog:",
    "@happyvertical/translator": "catalog:",
    "@sveltejs/adapter-node": "^5.5.4",
    "lucide-svelte": "catalog:"
  },
  "devDependencies": {
    "@sveltejs/kit": "^2.55.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@types/node": "^24.10.1",
    "playwright": "^1.58.2",
    "svelte": "^5.55.5",
    "svelte-check": "^4.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.2",
    "vitest": "^4.1.5"
  }
}
