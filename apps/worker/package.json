{
  "name": "@happyvertical/smrt-saas-worker",
  "version": "0.1.1",
  "private": true,
  "description": "Background worker for SMRT SaaS starter jobs.",
  "type": "module",
  "main": "./dist/index.js",
  "files": [
    "dist/"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:report-refresh-pg": "tsx --tsconfig ../web/tsconfig.json test-support/report-refresh-pg.integration.mjs",
    "test:report-export-pg": "tsx --tsconfig ../web/tsconfig.json test-support/report-refresh-pg.integration.mjs",
    "lint": "biome lint src",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@happyvertical/jobs": "catalog:",
    "@happyvertical/logger": "catalog:",
    "@happyvertical/smrt-app-runtime": "catalog:",
    "@happyvertical/smrt-assets": "catalog:",
    "@happyvertical/smrt-jobs": "catalog:",
    "@happyvertical/smrt-profiles": "catalog:",
    "@happyvertical/smrt-reports": "catalog:",
    "@happyvertical/smrt-saas-objects": "workspace:*",
    "@happyvertical/smrt-core": "catalog:",
    "@happyvertical/smrt-subscriptions": "catalog:",
    "@happyvertical/smrt-tenancy": "catalog:",
    "@happyvertical/smrt-users": "catalog:"
  },
  "devDependencies": {
    "tsx": "^4.20.6",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
