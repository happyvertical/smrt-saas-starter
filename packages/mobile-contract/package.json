{
  "name": "@happyvertical/smrt-saas-mobile-contract",
  "version": "0.1.0",
  "private": true,
  "description": "Shared mobile contract definitions for the SMRT SaaS starter.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "generate": "node scripts/generate-mobile-contract.mjs",
    "test": "node --test scripts/*.test.mjs",
    "lint": "biome lint src scripts",
    "clean": "rm -rf dist generated"
  },
  "dependencies": {
    "@happyvertical/smrt-saas-objects": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
