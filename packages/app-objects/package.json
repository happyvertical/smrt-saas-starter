{
  "name": "@happyvertical/smrt-saas-objects",
  "version": "0.1.1",
  "private": true,
  "description": "Starter SMRT objects and subscription/usage services for the SMRT SaaS reference app.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./manifest": "./dist/manifest.json",
    "./manifest.json": "./dist/manifest.json"
  },
  "scripts": {
    "build": "vite build --mode library && tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "biome lint src",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@happyvertical/accounting": "catalog:",
    "@happyvertical/logger": "catalog:",
    "@happyvertical/smrt-reports": "catalog:",
    "@happyvertical/smrt-types": "catalog:",
    "@happyvertical/sql": "catalog:",
    "@happyvertical/smrt-subscriptions": "catalog:",
    "@happyvertical/smrt-tenancy": "catalog:",
    "@happyvertical/smrt-agents": "catalog:",
    "@happyvertical/smrt-users": "catalog:"
  },
  "peerDependencies": {
    "@happyvertical/smrt-core": "catalog:"
  },
  "devDependencies": {
    "@happyvertical/smrt-core": "catalog:",
    "typescript": "5.9.3",
    "vite": "8.1.4",
    "vitest": "4.1.10"
  }
}
